<Window x:Class="ReleasePilot.BackgroundWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="后台服务" Width="600" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="后台服务" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="独立的 Windows 系统服务，关闭界面后继续检查。" Foreground="{StaticResource Muted}" Margin="0,10,0,20"/></StackPanel>
 <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20"><StackPanel>
 <TextBlock x:Name="ServiceStatus" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="CheckStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,15"/>
 <CheckBox x:Name="EnabledOption" Content="启用此用户的定时检查与更新提醒" Margin="0,0,0,16"/>
 <TextBlock Text="检查间隔（分钟，5–1440）" Margin="0,0,0,8"/><TextBox x:Name="IntervalInput"/>
 <TextBlock Text="服务专用 HTTP 代理（可选，例如 http://127.0.0.1:7890）" Margin="0,14,0,8"/><TextBox x:Name="ProxyInput"/>
 <TextBlock Text="服务开机自动启动，不保留桌面界面或托盘进程。通知助手每 5 分钟短暂检查提醒，随即退出；未登录时只检查，登录后再提醒。只通知，不自动安装。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
 <TextBlock Text="安装、修复或卸载此电脑的服务需要管理员授权。服务使用 LocalService 低权限账户，不会读取你的 EXE 或软件目录；系统勿扰模式可能隐藏通知。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
 </StackPanel></Border>
 <StackPanel Grid.Row="2" Margin="0,18,0,0"><WrapPanel x:Name="ActionsPanel"><Button Content="安装 / 修复服务" Click="Install_Click"/><Button Content="卸载服务" Click="Uninstall_Click" Margin="8,0,8,0"/><Button Content="关闭" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></WrapPanel><TextBlock x:Name="ErrorText" Foreground="#BD4255" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</Window>
