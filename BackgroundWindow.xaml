<Window x:Class="ReleasePilot.BackgroundWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="后台与通知" Width="540" Height="490" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="后台与通知" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="在 Windows 托盘中检查新版本，点击提醒即可打开软件。" Foreground="{StaticResource Muted}" Margin="0,10,0,20" TextWrapping="Wrap"/></StackPanel>
 <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20"><StackPanel>
 <CheckBox x:Name="EnabledOption" Content="开启后台检测与新版本通知" Margin="0,0,0,16"/>
 <CheckBox x:Name="LoginOption" Content="登录 Windows 后自动在后台启动" Margin="0,0,0,16"/>
 <TextBlock Text="检查间隔（分钟，5–1440）" Margin="0,0,0,8"/><TextBox x:Name="IntervalInput"/>
 <TextBlock Text="开启后，关闭主窗口会继续在托盘运行。右键托盘图标可退出。只提醒更新，不自动安装；同一版本只提醒一次。Windows 勿扰模式可能隐藏提醒。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
 </StackPanel></Border>
 <StackPanel Grid.Row="2" Margin="0,18,0,0"><WrapPanel><Button Content="打开临时 / 历史更新目录" Click="OpenUpdates_Click" ToolTip="旧版备份和安装器临时文件可能仍保留在此处，可自行清理。今后的更新不再创建备份。"/><Button Content="取消" Click="Cancel_Click" Margin="8,0,8,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></WrapPanel><TextBlock x:Name="ErrorText" Foreground="#BD4255" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</Window>
