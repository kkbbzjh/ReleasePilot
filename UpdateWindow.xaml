<Window x:Class="ReleasePilot.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="安装与更新 · ReleasePilot" Width="740" Height="810" MinWidth="660" MinHeight="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22"><StackPanel>
            <TextBlock Text="软件订阅 / 安装与更新" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
            <TextBlock Text="安装与更新" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="ReleaseLabel" Margin="0,7,60,0" Foreground="{StaticResource SecondaryInkBrush}" TextWrapping="Wrap"/>
        </StackPanel><Image Source="/ReleasePilot;component/Assets/logo.png" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="OptionsPanel" Margin="0,0,8,0">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel>
                <TextBlock Text="01  选择发布附件" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="确认操作系统与架构，再选择更新方式。" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
                <ComboBox x:Name="AssetList" SelectionChanged="Asset_Changed" AutomationProperties.Name="Release 附件"/>
                <TextBlock Text="更新方式" Foreground="{StaticResource SecondaryInkBrush}" Margin="0,16,0,7"/>
                <ComboBox x:Name="KindList" SelectionChanged="Kind_Changed" AutomationProperties.Name="更新方式"><ComboBoxItem Content="安装程序 · EXE / MSI" Tag="installer"/><ComboBoxItem Content="解压更新 · ZIP / 7z" Tag="archive"/><ComboBoxItem Content="单文件更新 · 替换本地 EXE" Tag="replace"/></ComboBox>
                <TextBlock Text="EXE 可能是安装包或单文件，请根据软件的发布说明选择。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20"><StackPanel>
                <TextBlock Text="02  配置更新位置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock x:Name="TargetLabel" Text="目标位置" Foreground="{StaticResource SecondaryInkBrush}" Margin="0,0,0,7"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TargetInput" AutomationProperties.Name="更新目标位置"/><Button Grid.Column="1" x:Name="BrowseButton" Content="浏览…" Click="Browse_Click" Margin="8,0,0,0"/></Grid>
                <StackPanel x:Name="ArchiveOptions" Visibility="Collapsed">
                    <TextBlock Text="保留文件与目录" Foreground="{StaticResource SecondaryInkBrush}" Margin="0,16,0,7"/>
                    <TextBox x:Name="PreserveInput" AutomationProperties.Name="保留路径" ToolTip="相对目标目录，用分号分隔。例如 mpv.conf;input.conf;portable_config/mpv.conf。填写目录名会保留整个目录，不支持通配符。"/>
                    <TextBlock Text="使用相对路径，多个路径以分号分隔；这些内容不会被覆盖。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,12"/>
                    <CheckBox x:Name="UnwrapArchive" Content="去掉压缩包唯一的顶层目录"/>
                </StackPanel>
                <Border Background="{StaticResource AccentTintBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock x:Name="Explanation" TextWrapping="Wrap" Foreground="{StaticResource SecondaryInkBrush}" FontSize="12"/></Border>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,18"><StackPanel>
            <TextBlock x:Name="ProgressText" Text="准备就绪 · 更新前会再次核对附件与目标位置。" TextWrapping="Wrap"/>
            <TextBlock x:Name="CurrentFileText" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryInkBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="ProgressDetails" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
            <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
        </StackPanel></Border>
        <Grid Grid.Row="3"><TextBlock Text="旧文件备份将保存在本机" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="关闭" Click="Cancel_Click" MinWidth="90" Margin="0,0,10,0"/><Button x:Name="ApplyButton" Content="下载并更新" Click="Apply_Click" Style="{StaticResource PrimaryButton}" MinWidth="130"/></StackPanel></Grid>
    </Grid>
</Window>
