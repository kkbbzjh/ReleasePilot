<Window x:Class="ReleasePilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReleasePilot · 开源更新管家" Icon="/Assets/ReleasePilot.ico" Width="1220" Height="860" MinWidth="1040" MinHeight="780" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" Foreground="#202B40" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#768297"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#42516A"/><Setter Property="BorderBrush" Value="#DDE3ED"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#4266E8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#4266E8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4266E8"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFD"/><Setter Property="Foreground" Value="#768297"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="16,13"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#EAF0F6"/></Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#202B40"/><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#EEF2F7"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F6F8FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EBF0FF"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="VersionText" TargetType="TextBlock"><Setter Property="Foreground" Value="#627089"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#E5EAF2"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#17243B">
            <Grid Margin="22,30,22,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="/Assets/logo.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <TextBlock Text="ReleasePilot" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="让每一次更新，都有迹可循" FontSize="10" Foreground="#93A5C1" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,42,0,0">
                    <TextBlock Text="工作空间" Foreground="#8295B4" FontSize="11" Margin="10,0,0,12"/>
                    <Border Background="#2B3F62" CornerRadius="8" Padding="12"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="#9DB5FF" Margin="0,0,10,0"/><TextBlock Text="软件订阅" Foreground="White" FontWeight="SemiBold"/></StackPanel></Border>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="#304059" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel>
                    <TextBlock Text="●  本地存储" Foreground="#ACDBC8" FontSize="12"/><TextBlock Text="订阅数据保存在此设备" Foreground="#8295B4" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="通过 Windows 系统代理连接" Foreground="#8295B4" FontSize="10" Margin="0,5,0,0"/>
                </StackPanel></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28,28,28,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="8"/><RowDefinition Height="240" MinHeight="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <StackPanel><TextBlock Text="软件订阅" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="集中追踪 GitHub Release，掌握你的软件更新。" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="↻  检查全部更新" Click="CheckAll_Click" Padding="18,11"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="18,10"><StackPanel><TextBlock Text="全部订阅" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,10"><StackPanel><TextBlock Text="发现更新" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UpdateCountText" Text="0" Foreground="#D27B22" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,10"><StackPanel><TextBlock Text="已关联 EXE" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LinkedCountText" Text="0" Foreground="#4266E8" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0"><Grid>
                    <TextBox x:Name="RepoInput" Padding="14,11" FontSize="13" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyDown="RepoInput_KeyDown" AutomationProperties.Name="GitHub 仓库地址" ToolTip="输入 owner/repo 或 https://github.com/owner/repo"/>
                    <TextBlock Text="输入 GitHub 仓库地址，例如 microsoft/PowerToys" Foreground="#98A3B6" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RepoInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid></Border>
                <Button Grid.Column="1" Content="＋ 添加订阅" Click="Add_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True"><Grid Margin="1">
                <DataGrid x:Name="SubscriptionsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Grid_SelectionChanged" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="54" Background="Transparent" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="仓库" Binding="{Binding Repo}" Width="2*" MinWidth="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Repo}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        <DataGridTextColumn Header="本地版本" Binding="{Binding LocalVersion}" Width="*" MinWidth="90" ElementStyle="{StaticResource VersionText}"/>
                        <DataGridTextColumn Header="最新版本" Binding="{Binding LatestVersion}" Width="*" MinWidth="90" ElementStyle="{StaticResource VersionText}"/>
                        <DataGridTemplateColumn Header="状态" Width="1.5*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Border CornerRadius="5" Padding="9,5" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0F3F8"/><Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="发现更新"><Setter Property="Background" Value="#FFF1DD"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已是最新"><Setter Property="Background" Value="#E5F5ED"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="已是最新（已确认）"><Setter Property="Background" Value="#E5F5ED"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="发现新发布"><Setter Property="Background" Value="#FFF1DD"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="检查失败"><Setter Property="Background" Value="#FDEBED"/></DataTrigger>
                            </Style.Triggers></Style></Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64738A"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="发现更新"><Setter Property="Foreground" Value="#A96210"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="已是最新"><Setter Property="Foreground" Value="#237B52"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="检查失败"><Setter Property="Foreground" Value="#BD4255"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Border>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="最后检查" Binding="{Binding CheckedAt}" Width="1.5*" MinWidth="145" ElementStyle="{StaticResource VersionText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SubscriptionsGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="从第一个订阅开始" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="在上方添加 GitHub 仓库，随时掌握最新 Release。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid></Border>
            <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="18,15"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="更新日志" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="选择订阅，查看版本详情与发布说明" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SubscriptionsGrid}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Button Content="关联 EXE" Click="LinkExe_Click" Padding="12,8" Margin="0,0,8,0" ToolTip="选择本地软件的主程序，读取并比较文件版本"/><Button Content="关联目录" Click="LinkFolder_Click" Padding="12,8" Margin="0,0,8,0"/><Button Content="查看 Release ↗" Click="OpenRelease_Click" Padding="12,8" Margin="0,0,8,0"/><Button Content="删除" Click="Delete_Click" Padding="12,8" Foreground="#BE4D5E"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SubscriptionsGrid}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="版本对不上？更新后可手动确认。" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="安装 / 更新" Click="Update_Click" Padding="12,8" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"/><Button Grid.Column="2" Content="确认已安装当前版" Click="ConfirmInstalled_Click" Padding="12,8" Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="3" Content="取消确认" Click="ClearConfirmation_Click" Padding="12,8" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
                <TextBox Grid.Row="1" x:Name="NotesBox" Text="还没有选择订阅。添加仓库后，在列表中选择软件即可查看详情。" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Foreground="#627089" Padding="0,4,8,0"/>
            </Grid></Border>
            <TextBlock Grid.Row="6" x:Name="StatusText" Text="就绪 · 数据保存在本机" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,12,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Grid>
    </Grid>
</Window>
