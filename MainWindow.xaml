<Window x:Class="ReleasePilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ReleasePilot · 开源更新管家" Width="1050" Height="690" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#F5F6FA">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="ReleasePilot" FontSize="29" FontWeight="Bold" Foreground="#24263B"/><TextBlock Text="GitHub 软件订阅 · 本地 EXE 版本追踪" Foreground="#72778B" FontSize="13"/></StackPanel>
 <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RepoInput" Grid.Column="0" Padding="11,8" FontSize="14" VerticalContentAlignment="Center" ToolTip="输入 https://github.com/owner/repo 或 owner/repo"/><Button Grid.Column="1" Content="＋ 添加订阅" Click="Add_Click" Margin="8,0,0,0" Padding="16,8"/><Button Grid.Column="2" Content="⟳ 检查全部" Click="CheckAll_Click" Margin="8,0,0,0" Padding="16,8"/></Grid>
 <DataGrid Grid.Row="2" x:Name="SubscriptionsGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="38" Background="White" BorderBrush="#DCE0EA"><DataGrid.Columns><DataGridTextColumn Header="GitHub 仓库" Binding="{Binding Repo}" Width="2*"/><DataGridTextColumn Header="本地版本" Binding="{Binding LocalVersion}" Width="*"/><DataGridTextColumn Header="最新版本" Binding="{Binding LatestVersion}" Width="*"/><DataGridTextColumn Header="更新状态" Binding="{Binding Status}" Width="1.3*"/><DataGridTextColumn Header="最后检查" Binding="{Binding CheckedAt}" Width="1.6*"/></DataGrid.Columns></DataGrid>
 <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,8"><TextBlock Text="更新日志 / 软件详情" FontWeight="Bold" FontSize="15" DockPanel.Dock="Left" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关联 EXE" Click="LinkExe_Click" Margin="5,0" Padding="12,5"/><Button Content="查看 Release" Click="OpenRelease_Click" Margin="5,0" Padding="12,5"/><Button Content="删除订阅" Click="Delete_Click" Margin="5,0" Padding="12,5"/></StackPanel></DockPanel><TextBox Grid.Row="1" x:Name="NotesBox" Text="选择一项订阅查看更新日志" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" Background="White" BorderBrush="#DCE0EA"/></Grid>
 <TextBlock Grid.Row="4" x:Name="StatusText" Text="就绪 · 数据保存在本机" Foreground="#73798C" Margin="0,10,0,0"/>
 </Grid>
</Window>
